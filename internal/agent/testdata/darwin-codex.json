{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/pushward agent hook codex",
            "timeout": 1560
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/pushward agent hook codex",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
